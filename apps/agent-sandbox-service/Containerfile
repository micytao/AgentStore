# Agent Sandbox Service — owns all OpenShell sandbox lifecycle + terminal relay.
# Uses @nvidia/openshell-sdk (pure JS gRPC client) — no CLI binary, no node-pty.
FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS build
USER 0
WORKDIR /app

COPY package.json package-lock.json* .npmrc ./
COPY apps/agent-sandbox-service ./apps/agent-sandbox-service
COPY packages ./packages
# GITHUB_TOKEN is needed for npm to authenticate to GitHub Packages
# (where @nvidia/openshell-sdk is published). Passed as a build arg
# from the OpenShift BuildConfig's dockerStrategy.env.
ARG GITHUB_TOKEN
RUN npm install
RUN npm run build --workspace=@agentstore/agent-sandbox-service

FROM registry.access.redhat.com/ubi9/nodejs-22:latest
USER 0
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/agent-sandbox-service/dist ./apps/agent-sandbox-service/dist
COPY --from=build /app/apps/agent-sandbox-service/package.json ./apps/agent-sandbox-service/package.json
COPY --from=build /app/packages ./packages

ENV NODE_ENV=production
ENV PORT=8090
EXPOSE 8090
USER 1001

CMD ["node", "apps/agent-sandbox-service/dist/server.js"]
