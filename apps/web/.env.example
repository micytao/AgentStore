# Uncomment to send Engineering work-with-me listings to the in-cluster
# Agent Sandbox Service (apps/agent-sandbox-service) instead of a simulated
# session. The console never runs the openshell CLI or node-pty itself —
# it only calls this service's REST + WebSocket API. See
# apps/agent-sandbox-service/README.md for how to deploy the service.
# OPENSHELL_SERVICE_URL=https://agent-sandbox-service-agent-workloads.apps.example.com
# OPENSHELL_SERVICE_TOKEN=
# CATALOG_DIR=

# Prefer configuring these in Admin → Platform / Secrets. Env vars work too.
# AAP_CONTROLLER_URL=https://aap.example.com
# AAP_TOKEN=
# AAP_JOB_TEMPLATE_ID=42
# AAP_CONSOLE_URL=https://aap.example.com
# Defaults to true (workshop/self-signed certs). Set false for production.
# AAP_INSECURE_TLS=true
# OPENSHIFT_API_URL=https://api.cluster.example.com:6443
# OPENSHIFT_TOKEN=
# OPENSHIFT_NAMESPACE=agent-workloads
# OPENSHIFT_CONSOLE_URL=https://console-openshift-console.apps.example.com
# The kube-apiserver's cert (api.<cluster>:6443) is commonly self-signed even
# on clusters with a real Route/console wildcard cert (e.g. workshop clusters).
# Defaults to true (workshop/self-signed kube-apiserver certs). Set false for production.
# OPENSHIFT_INSECURE_TLS=true
