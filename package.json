{
  "name": "agent-store",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@agentstore/web",
    "build": "npm run build --workspace=@agentstore/web",
    "start": "npm run start --workspace=@agentstore/web",
    "sandbox-service:build": "npm run build --workspace=@agentstore/agent-sandbox-service",
    "sandbox-service:start": "npm run start --workspace=@agentstore/agent-sandbox-service",
    "import-redhat-skills": "tsx scripts/import-redhat-skills.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "js-yaml": "^4.1.0",
    "@types/js-yaml": "^4.0.9"
  }
}
